<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- MyAI does no tracking: no analytics, no ad networks, no third-party SDKs. -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No data is collected. Inference runs on device, and chats, agents,
	     skills, and knowledge stay in the person's own private iCloud
	     database, which the developer cannot access. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults stores this app's own settings (temperature, sampling
		     mode, instructions, feature toggles). CA92.1 covers accessing
		     information from the app itself. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
